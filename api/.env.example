# Deve bater com o `environment:` do serviço `db` em docker-compose.yml —
# mesmo padrão do aporte-facil (credenciais fixas em dev, sem interpolação).
DATABASE_URL=postgresql+psycopg://lume:lume@db:5432/lume

# Lista de chaves aceitas via header X-API-Key, separadas por vírgula.
# Auth MVP por chave estática — ver project/ARCHITECTURE.md.
API_KEYS=local-dev-key-change-me

# Segundos até um dado cacheado ser considerado "velho" e disparar nova
# busca na fonte original na próxima requisição pra essa série.
CACHE_TTL_SECONDS=3600

# TTL específico da cotação de ação (muda rápido, TTL bem menor que o geral acima).
STOCK_QUOTE_TTL_SECONDS=300

# TTL específico de fundamentos trimestrais/anuais (CVM, bolsai, SEC EDGAR) — TTL bem maior.
FUNDAMENTALS_TTL_SECONDS=86400

# TTL específico da cotação de cripto (muda rápido, mesmo valor da cotação de ação).
CRYPTO_QUOTE_TTL_SECONDS=300

# bolsai (fundamentos de ação BR) — chave gratuita via login Google em
# usebolsai.com/dashboard.
BOLSAI_API_KEY=changeme

# SEC EDGAR exige um e-mail de contato no header User-Agent (não é autenticação,
# só a política deles: https://www.sec.gov/os/webmaster-faq#developers).
SEC_EDGAR_CONTACT_EMAIL=changeme@example.com
